# Copy to .env and fill in. Secrets live only in this file: never in the database, never in logs.

# Binance Demo Trading keys: log in to Binance, open Demo Trading, then API Management
# (demo.binance.com/en/my/settings/api-management). Used by bots whose account is "demo".
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Real-money keys, used by bots whose account is "live". Leave empty until the demo matches the backtests.
# Give the key trading rights only (never withdrawals) and restrict it to your server's IP.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# Live bots refuse to start unless this is 1.
LIVE_TRADING_ENABLED=0

# Web page address. Keep 127.0.0.1 on the Mac; on the VPS the HTTPS proxy in front of it is the only way in.
HOST=127.0.0.1
PORT=8787

# Set both to 1 on the VPS behind HTTPS (nginx or Caddy).
COOKIE_SECURE=0
TRUST_PROXY=0

# Where bot.db (bots, candles, trades, orders, events) is kept. Relative paths start at this folder.
DATA_DIR=data

# Your bist-charts checkout, for `npm run sync-engine` and the "engine is behind" notice.
BIST_CHARTS_DIR=../bist-charts

# Telegram alerts (not wired yet: step 4).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
